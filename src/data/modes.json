{
  "_comment": "Vendor CLI profiles (P3-T02): prompt → mode patterns and identification clues. Applied by the backend DeviceObserver to the last output line (ANSI removed). Patterns are Rust `regex` syntax; prompts are tried in order (first match wins), `host`/`sub` named groups are optional. `identify`: case-insensitive patterns over banner / login / `show version` text, each with a weight; the best total ≥ `minScore` wins. Ruijie and Cisco prompts look alike: without a vendor clue a session stays `cisco-like` (spec 7.3). `reload`: lines that mean the device is restarting (the session stays up; the next prompt ends it). `identity`: read-only command run once in the background after login (output hidden) and per-field patterns (`v` group = value, `h` = host name; lines are matched one by one, first hit wins).",
  "minScore": 3,
  "defaultProfile": "cisco-like",
  "reload": [
    "^System Bootstrap, Version",
    "^Initializing Hardware",
    "%SYS-5-RELOAD",
    "Proceed with reload\\? \\[confirm\\]\\s*$",
    "^\\s*Restricted Rights Legend",
    "^Starting system, please wait",
    "^System is rebooting",
    "^Rebooting the system",
    "^Boot ROM ",
    "^BootLoader version",
    "^U-Boot \\d"
  ],
  "profiles": [
    {
      "id": "cisco-like",
      "label": "Cisco-like CLI",
      "family": "generic",
      "identify": [],
      "prompts": [
        {
          "mode": "boot",
          "re": "^rommon \\d+ ?>\\s*$"
        },
        {
          "mode": "boot",
          "re": "^(?:switch|loader):\\s*$"
        },
        {
          "mode": "config",
          "re": "^(?P<host>[\\w.\\-]+)\\((?P<sub>config[^)]*)\\)#\\s*$"
        },
        {
          "mode": "privileged",
          "re": "^(?P<host>[\\w.\\-]+)#\\s*$"
        },
        {
          "mode": "user",
          "re": "^(?P<host>[\\w.\\-]+)>\\s*$"
        }
      ],
      "paging": {
        "more": "--More--",
        "disable": "terminal length 0"
      },
      "identity": {
        "command": "show version",
        "fields": {
          "version": [
            "Cisco IOS[ -]XE Software,? (?:\\[[^\\]]*\\] )?Version (?P<v>[\\w.()]+)",
            "Cisco IOS Software.*?, Version (?P<v>[\\w.()]+)",
            "^ROM: .*Version (?P<v>[\\w.()]+)"
          ],
          "model": [
            "^Model [Nn]umber\\s*:\\s*(?P<v>\\S+)",
            "^[Cc]isco (?P<v>(?:WS-|C|ISR|ASR|N)[\\w-]+) \\(.*\\) processor"
          ],
          "serial": [
            "^System [Ss]erial [Nn]umber\\s*:\\s*(?P<v>\\S+)",
            "Processor board ID (?P<v>\\w+)"
          ],
          "uptime": ["^(?P<h>[\\w.-]+) uptime is (?P<v>.+)$"]
        }
      }
    },
    {
